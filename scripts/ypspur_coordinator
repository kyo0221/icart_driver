#!/usr/bin/env sh

# Author : Daiki Maekawa

PARAM=$1
DEVICE=/dev/sensors/icart-mini

if [ -z "$PARAM" ]; then
  echo "usage: $0 <ypspur.param>" >&2
  exit 1
fi

CPID=""
cleanup() {
  [ -n "$CPID" ] && kill "$CPID" 2>/dev/null
  exit 0
}
trap cleanup INT TERM

echo "robot parameters [$PARAM], device [$DEVICE]"

while true
do
  while [ ! -e "$DEVICE" ]; do
    echo "icart device [$DEVICE] not found. waiting... (check USB cable and robot power)"
    sleep 2
  done

  ipcrm -Q 0x00007045 2>/dev/null && echo "removed stale ypspur message queue"
  ypspur-coordinator -p "$PARAM" -d "$DEVICE" &
  CPID=$!
  wait "$CPID"
  echo "ypspur-coordinator exited. restarting..."
  CPID=""
  sleep 1
done
